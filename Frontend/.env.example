# Backend API URL
NEXT_PUBLIC_API_URL="http://localhost:5000/api"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Contact Form Recipient Email
CONTACT_RECIPIENT_EMAIL=info@bizonance.in

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
