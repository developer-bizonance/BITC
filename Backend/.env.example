PORT=5000
NODE_ENV=development

# Neon PostgreSQL Database Connection
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=verify-full"

# JWT Secret Key
JWT_SECRET="your-jwt-secret-key"

# CORS Allowed Origins (Comma separated)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,https://bitc.bizonance.com,https://bitcadmin.bizonance.com"

# SMTP Email Configuration
CONTACT_RECIPIENT_EMAIL=info@bizonance.in
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@bizonance.in
SMTP_PASS=your-app-password
SMTP_FROM="BITC Website Inquiries <info@bizonance.in>"
